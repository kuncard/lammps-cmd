{
  "nodes": [
    {
      "id": "units",
      "phase": "init",
      "title": "units",
      "desc": "Unit system: metal (eV,Å,ps) for materials, real (kcal,Å,fs) for bio",
      "url": "https://docs.lammps.org/units.html"
    },
    {
      "id": "boundary",
      "phase": "init",
      "title": "boundary",
      "desc": "Box boundaries: p p p for bulk NPT (periodic required for barostat)",
      "url": "https://docs.lammps.org/boundary.html"
    },
    {
      "id": "timestep",
      "phase": "init",
      "title": "timestep",
      "desc": "Integration step. metal: 0.001ps, real: 1.0fs. Tdamp~100*dt, Pdamp~1000*dt",
      "url": "https://docs.lammps.org/timestep.html"
    },
    {
      "id": "atom_style",
      "phase": "init",
      "title": "atom_style",
      "desc": "Atom model: atomic (no bonds), charge, full (bonded), molecular",
      "url": "https://docs.lammps.org/atom_style.html"
    },
    {
      "id": "lattice",
      "phase": "system",
      "title": "lattice",
      "desc": "Crystal structure: lattice fcc 4.05 (Al), bcc, sc, custom",
      "url": "https://docs.lammps.org/lattice.html"
    },
    {
      "id": "region",
      "phase": "system",
      "title": "region",
      "desc": "Spatial region: block, sphere, cylinder. Used by create_box, create_atoms",
      "url": "https://docs.lammps.org/region.html"
    },
    {
      "id": "create_box",
      "phase": "system",
      "title": "create_box",
      "desc": "Create simulation box from region + atom types",
      "url": "https://docs.lammps.org/create_box.html"
    },
    {
      "id": "create_atoms",
      "phase": "system",
      "title": "create_atoms",
      "desc": "Fill box with atoms on lattice: create_atoms 1 box",
      "url": "https://docs.lammps.org/create_atoms.html"
    },
    {
      "id": "read_data",
      "phase": "system",
      "title": "read_data",
      "desc": "Read structure from data file (alternative to create_* commands)",
      "url": "https://docs.lammps.org/read_data.html"
    },
    {
      "id": "velocity",
      "phase": "system",
      "title": "velocity",
      "desc": "Initialize velocities: create 300.0 4928459 (random at 300K)",
      "url": "https://docs.lammps.org/velocity.html"
    },
    {
      "id": "pair_style",
      "phase": "force",
      "title": "pair_style lj/cut",
      "desc": "L-J 12-6: E=4ε[(σ/r)¹²−(σ/r)⁶]. Basic potential for generic MD",
      "url": "https://docs.lammps.org/pair_style.html"
    },
    {
      "id": "pair_coeff",
      "phase": "force",
      "title": "pair_coeff",
      "desc": "Set ε,σ per atom pair: pair_coeff * * 1.0 1.0 2.5",
      "url": "https://docs.lammps.org/pair_coeff.html"
    },
    {
      "id": "fix_nve",
      "phase": "integ",
      "title": "fix nve",
      "desc": "Plain NVE (velocity-Verlet). No thermostat — use when combining with fix langevin",
      "url": "https://docs.lammps.org/fix_nve.html"
    },
    {
      "id": "fix_langevin",
      "phase": "integ",
      "title": "fix langevin",
      "desc": "Langevin thermostat. F=Fc+Ff+Fr. Stochastic. Must combine WITH fix nve",
      "url": "https://docs.lammps.org/fix_langevin.html"
    },
    {
      "id": "fix_nh",
      "phase": "integ",
      "title": "fix nvt / npt",
      "desc": "Nose-Hoover thermostat+barostat. NVT (T only) / NPT (T+P). Do NOT combine with fix nve",
      "url": "https://docs.lammps.org/fix_nh.html"
    },
    {
      "id": "compute_temp",
      "phase": "compute",
      "title": "compute temp",
      "desc": "T=2Ekin/(Nk_B). Auto: thermo_temp. DOF accounts for constraints",
      "url": "https://docs.lammps.org/compute_temp.html"
    },
    {
      "id": "compute_pressure",
      "phase": "compute",
      "title": "compute pressure",
      "desc": "P=(NkBT+Virial)/V. Auto: thermo_press. Needs temp compute",
      "url": "https://docs.lammps.org/compute_pressure.html"
    },
    {
      "id": "thermo",
      "phase": "output",
      "title": "thermo",
      "desc": "Print every N steps: thermo 100. 0=start/end only",
      "url": "https://docs.lammps.org/thermo.html"
    },
    {
      "id": "thermo_style",
      "phase": "output",
      "title": "thermo_style",
      "desc": "Content: one, multi, custom step temp pe etotal press vol",
      "url": "https://docs.lammps.org/thermo_style.html"
    },
    {
      "id": "dump",
      "phase": "output",
      "title": "dump",
      "desc": "Write trajectory: dump 1 all custom 100 dump.lammpstrj id type x y z",
      "url": "https://docs.lammps.org/dump.html"
    },
    {
      "id": "Howto_thermostat",
      "phase": "howto",
      "title": "Thermostat Guide",
      "desc": "Nose-Hoover (fix nvt), Langevin (fix langevin), Berendsen, rescale",
      "url": "https://docs.lammps.org/Howto_thermostat.html"
    },
    {
      "id": "Howto_barostat",
      "phase": "howto",
      "title": "Barostat Guide",
      "desc": "NPT: iso/aniso/tri. Pdamp~1000*dt liquid, ~10000*dt solid. Periodic required",
      "url": "https://docs.lammps.org/Howto_barostat.html"
    }
  ],
